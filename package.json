{
  "name": "read_pdf",
  "version": "2.0.0",
  "private": true,
  "description": "ReadPDF — lector PDF con experiencia de libro (Tauri desktop + web)",
  "scripts": {
    "dev:web": "pnpm --filter @readpdf/web dev",
    "dev:desktop": "pnpm --filter @readpdf/desktop tauri dev",
    "dev:server": "pnpm --filter @readpdf/server dev",
    "dev:playground": "pnpm --filter @readpdf/playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
