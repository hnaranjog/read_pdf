{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capacidad por defecto de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "fs:scope",
      "allow": ["**"]
    }
  ]
}
